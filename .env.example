# ==========================================
# Application & Database Configuration
# ==========================================
# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/portfolio

# App Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# ==========================================
# Authentication & Security (JWT)
# ==========================================
# Secret key used to sign access tokens (Change this to a strong random string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Secret key used to sign refresh tokens
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production

# Token expiration durations
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=120d

# ==========================================
# Email Service (Resend)
# ==========================================
# Resend API key for contact form email delivery
RESEND_API_KEY=re_123456789abcdef

# ==========================================
# Public Frontend & API URLs
# ==========================================
# Public site URL (used for canonical URLs, sitemaps, and CORS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL (optional, defaults to http://localhost:3000/api if not set)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ==========================================
# Medium Articles Integration
# ==========================================
# Medium username to fetch recent publications via RSS
NEXT_PUBLIC_MEDIUM_USERNAME=shrhossain786

# ==========================================
# Analytics (Optional)
# ==========================================
# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ==========================================
# AI Portfolio Assistant (Groq / Grok)
# ==========================================
# Groq API Key (Free, ultra-fast via https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model (default: openai/gpt-oss-120b or openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# If using xAI Grok instead:
# XAI_API_KEY=xai-your_xai_api_key_here
# XAI_MODEL=grok-beta
